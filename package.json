{
  "name": "zotero-pdf-compress",
  "type": "module",
  "version": "0.1.0",
  "description": "Zotero 插件：右键压缩论文 PDF 附件（内置 Ghostscript，保留标注）",
  "config": {
    "addonName": "PDF 压缩",
    "addonID": "zotero-pdf-compress@leewin0531.github.io",
    "addonRef": "pdfcompress",
    "addonInstance": "PdfCompress",
    "prefsPrefix": "extensions.zotero.pdfcompress"
  },
  "author": "LeeWin0531",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "zotero-plugin test",
    "fetch-gs": "bash scripts/fetch-ghostscript.sh",
    "update-deps": "npm update --save",
    "release": "zotero-plugin release"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "homepage": "https://github.com/LeeWin0531/zotero-pdf-compress",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeWin0531/zotero-pdf-compress.git"
  },
  "bugs": {
    "url": "https://github.com/LeeWin0531/zotero-pdf-compress/issues"
  }
}

startup-begin = 插件加载中
startup-finish = 插件已就绪
compress-menu =
    .label = 压缩 PDF
compress-balanced =
    .label = 均衡压缩
compress-aggressive =
    .label = 激进压缩
prefs-attachment-title = 附件处理方式
prefs-mode-overwrite =
    .label = 原地覆盖（推荐，保留标注）
prefs-mode-overwrite-desc = 直接替换原附件文件，附件条目不变，因此标注、高亮、笔记全部保留。压缩不可撤销。
prefs-mode-copy =
    .label = 新增副本
prefs-mode-copy-desc = 保留原附件，另存一个压缩后的副本。注意：新副本不包含原附件上的标注。
prefs-compress-title = 压缩选项
prefs-default-preset =
    .label = 默认预设
prefs-preset-balanced =
    .label = 均衡（150 DPI，画质优先）
prefs-preset-aggressive =
    .label = 激进（100 DPI，体积优先）
prefs-gain-threshold =
    .label = 无收益阈值
prefs-gain-2 =
    .label = 缩小不到 2% 就放弃（推荐）
prefs-gain-10 =
    .label = 缩小不到 10% 就放弃
prefs-gain-20 =
    .label = 缩小不到 20% 就放弃
prefs-gain-threshold-desc = 压缩后若未达到该幅度，视为无收益并保留原文件。
prefs-behavior-title = 行为
prefs-auto-close-reader =
    .label = 压缩前自动关闭该 PDF 的阅读器（Windows 下文件被锁定时必需）
prefs-show-result =
    .label = 压缩完成后显示结果提示